# Interop peer and tool pins for interop/run.sh (docs/interop.md).
# Each peer is its latest release tag on 2026-10-11, with the tag's commit; the build
# fails if the tag no longer points there. Change these only by a deliberate PR.

# ngtcp2/nghttp3 (example client and server, and curl's HTTP/3 stack).
NGHTTP3_TAG=v1.18.0
NGHTTP3_COMMIT=dbfc24286138cb0b6490160e7ca87fe1ce6722a0
NGTCP2_TAG=v1.25.0
NGTCP2_COMMIT=f9e9ff01ad2c8116bc09de4f644b0028a61486a6
CURL_TAG=curl-8_22_0
CURL_COMMIT=01346829096c61b372692f6dc43ffa778c6caccd

# quiche-client and quiche-server (quiche_apps). quiche commits no Cargo.lock, so its
# crate dependencies resolve at build time.
QUICHE_TAG=0.30.0
QUICHE_COMMIT=be47c5011215b9f13bad06bd7627d3ae49888a19

# h3spec release binary (tag v0.1.14, commit e40f52c421c6a3bb234c0c83089d73ec94572044).
H3SPEC_URL=https://github.com/kazu-yamamoto/h3spec/releases/download/v0.1.14/h3spec-linux-x86_64
H3SPEC_SHA256=7f2e3232715a3f6ff5212d408b2a3e74d6aa3ca06f96efca9a4e5dc55f3c6860

# Build and runtime images. The C peers use Debian trixie's OpenSSL (3.5, QUIC TLS API).
DEBIAN_IMAGE=debian:trixie-slim
RUST_IMAGE=rust:1.98-slim-trixie
